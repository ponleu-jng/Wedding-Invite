{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "displayName"]
    },
    "Message": {
      "title": "Message",
      "description": "Guest messages and blessings sent to the bride and groom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "message": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "senderName", "message", "createdAt"]
    },
    "RSVP": {
      "title": "RSVP",
      "description": "Guest wedding attendance response with optional photo and wishes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "guestCount": { "type": "number" },
        "attending": { "type": "string", "enum": ["yes", "no"] },
        "diet": { "type": "string", "enum": ["none", "vegetarian", "halal"] },
        "blessing": { "type": "string" },
        "photoUrl": { "type": "string" },
        "submittedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "guestCount", "attending", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Live guestbook messages and blessings"
    },
    "/rsvps/{rsvpId}": {
      "schema": "RSVP",
      "description": "Guest RSVP records"
    }
  }
}
